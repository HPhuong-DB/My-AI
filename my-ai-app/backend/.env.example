GEMINI_API_KEY=
WEB_SEARCH_PROVIDER=searxng
WEB_SEARCH_URL=http://127.0.0.1:8080/search
GEMINI_MODEL=gemini-2.5-flash

LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_KEEP_ALIVE=-1
OLLAMA_THINK=false
OLLAMA_THINK_FAST=false
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_FIRST_TOKEN_TIMEOUT_SECONDS=60
OLLAMA_FIRST_TOKEN_TIMEOUT_DEEP_SECONDS=90
OLLAMA_READ_TIMEOUT_SECONDS=30
OLLAMA_TOTAL_TIMEOUT_SECONDS=120
OLLAMA_TOTAL_TIMEOUT_DEEP_SECONDS=180
OLLAMA_NUM_CTX=6144
OLLAMA_NUM_PREDICT_FAST=128
OLLAMA_NUM_PREDICT_DEEP=384
LLM_CONTEXT_TIMEOUT_SECONDS=3
# Context windows include the current saved message: 6 recent exchanges for
# fast chat and 8 for deep chat when they fit the character budget.
LLM_HISTORY_LIMIT_FAST=13
LLM_HISTORY_LIMIT_DEEP=17
# Candidate pool before selecting up to 8 relevant active memories.
LLM_MEMORY_LIMIT=200
# Candidate pools and maximum relevant items recalled from each archive:
# researched knowledge and learned experience.
MEMORY_ARCHIVAL_CANDIDATE_LIMIT=40
MEMORY_ARCHIVAL_RECALL_LIMIT=3
# Recall ignores memories below this confidence score. TTL 0 means that store
# does not expire automatically; values above 0 are measured in days.
MEMORY_MIN_CONFIDENCE=0.35
KNOWLEDGE_TTL_DAYS=30
EXPERIENCE_TTL_DAYS=0
SESSION_SUMMARY_TTL_DAYS=90
EPISODIC_MEMORY_TTL_DAYS=365
# Scheduler interval for marking expired rows as forgotten (0 disables sweep).
MEMORY_FORGET_SWEEP_SECONDS=3600
# A new session starts after this many seconds without a completed reply.
SESSION_IDLE_SECONDS=1800
SESSION_SUMMARY_CANDIDATE_LIMIT=10
SESSION_SUMMARY_RECALL_LIMIT=2
EPISODIC_MEMORY_CANDIDATE_LIMIT=40
EPISODIC_MEMORY_RECALL_LIMIT=3
# Hybrid memory retrieval works lexically without another model. Enable the
# optional local embedding model after: ollama pull qwen3-embedding:0.6b
MEMORY_EMBEDDING_ENABLED=true
MEMORY_EMBEDDING_MODEL=qwen3-embedding:0.6b
MEMORY_EMBEDDING_TIMEOUT_SECONDS=1.2
MEMORY_EMBEDDING_FAILURE_COOLDOWN_SECONDS=300
MEMORY_EMBEDDING_CACHE_SIZE=512
MEMORY_EMBEDDING_MAX_ITEMS=48
MEMORY_RETRIEVAL_MIN_LEXICAL_SCORE=0.12
MEMORY_RETRIEVAL_MIN_SEMANTIC_SIMILARITY=0.48
LLM_MAX_CONTEXT_CHARS=8000
LLM_MAX_CONTEXT_CHARS_FAST=8000
LLM_TOTAL_TIMEOUT_SECONDS=35
TOOL_MAX_CALLS_PER_MINUTE=12
TOOL_TIMEOUT_SECONDS=15
TOOL_FILE_ROOT=./user_files
TOOL_MAX_FILE_BYTES=1048576

AGENT_IDLE_AFTER_SECONDS=300
AGENT_IDLE_COOLDOWN_SECONDS=300
AGENT_ACTION_COOLDOWN_SECONDS=10
AGENT_MINIMUM_ENERGY=0.05
REMINDER_SCHEDULER_INTERVAL_SECONDS=60
PROACTIVE_SCHEDULER_COOLDOWN_SECONDS=900
PROACTIVE_MAX_EVENTS_PER_CYCLE=5
PROACTIVE_MAX_EVENTS_PER_WINDOW=30
PROACTIVE_ACTION_WINDOW_SECONDS=3600
PROACTIVE_USER_COOLDOWN_SECONDS=900
PROACTIVE_MAX_EVENTS_PER_USER_WINDOW=3
SELF_LEARNING_MAX_UPDATES=10
SELF_LEARNING_WINDOW_SECONDS=3600
SELF_LEARNING_MAX_CONTENT_CHARS=12000


DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

OCR_MAX_UPLOAD_BYTES=5242880
OCR_MAX_IMAGE_DIMENSION=4096
OCR_MAX_IMAGE_PIXELS=16000000
DOCUMENT_MAX_UPLOAD_BYTES=10485760
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
